---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Jerzy Jasiński - malarz z Mazowsza. Portfolio obrazów abstrakcyjnych, wystawy, filmy oraz informacje kontaktowe artysty.',
} = Astro.props;

const siteTitle = title === 'Jerzy Jasiński' ? title : `${title} | Jerzy Jasiński`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://jerzyjasinski.pl').toString();
---

<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{siteTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:site_name" content="Jerzy Jasiński">
  <meta property="og:title" content={siteTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={siteTitle}>
  <meta name="twitter:description" content={description}>
  <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  </noscript>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Jerzy Jasiński',
    jobTitle: 'Painter',
    url: 'https://jerzyjasinski.pl',
    alumniOf: 'Akademia Sztuk Pięknych w Warszawie',
    sameAs: [
      'https://pl.wikipedia.org/wiki/Jerzy_Jasiński_(malarz)',
      'https://desa.pl/pl/artysci/jerzy-jasinski/',
      'https://www.facebook.com/profile.php?id=100089157185796',
    ],
  })} />

  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'papyrus' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <nav class="nawigacja">
    <a href="/" class="logo">Jerzy Jasiński</a>
    <div class="menu">
      <a href="/o-mnie">O mnie</a>
      <a href="/obrazy">Obrazy</a>
      <a href="/wystawy">Wystawy</a>
      <a href="/filmy">Filmy</a>
    </div>
    <button class="motyw-przelacz" type="button" aria-label="Przełącz na tryb ciemny">
      <!-- icon injected by JS -->
    </button>
  </nav>

  <slot />

  <footer class="stopka">
    <p>&copy; 2025 Jerzy Jasiński. Wszelkie prawa zastrzeżone.</p>
  </footer>
</body>
</html>

<script>
  const themes = ['light', 'dark', 'papyrus'];
  const icons = {
    light: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>',
    dark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h12a2 2 0 0 1 2 2v14H6a2 2 0 0 1-2-2z"/><path d="M4 4v14"/><path d="M20 6h2v12h-2"/></svg>',
    papyrus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M17.66 6.34l1.41-1.41"/></svg>'
  };
  const labels = {
    light: 'Przełącz na tryb ciemny',
    dark: 'Przełącz na motyw papirus',
    papyrus: 'Przełącz na tryb jasny'
  };

  const root = document.documentElement;
  const btn = document.querySelector('.motyw-przelacz');

  function current() {
    return root.getAttribute('data-theme') || 'light';
  }

  function render() {
    var t = current();
    btn.innerHTML = icons[t];
    btn.setAttribute('aria-label', labels[t]);
  }

  btn.addEventListener('click', function () {
    var next = themes[(themes.indexOf(current()) + 1) % themes.length];
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
    render();
  });

  render();
</script>

<style is:global>
  /* === TEMATY === */
  :root,
  [data-theme="light"] {
    --bg: #FDFCFA;
    --text: #000000;
    --muted-text: #4a4a4a;
    --soft-surface: #F5F3F0;
    --border: #000000;
    --border-soft: rgba(0, 0, 0, 0.08);
    --hover-bg: #F5F3F0;
    --nawigacja-bg: #FDFCFA;
    --film-item-border: rgba(0, 0, 0, 0.08);
    --linki-border: rgba(0, 0, 0, 0.3);
    --film-ornament: rgba(85, 61, 37, 0.35);
  }

  [data-theme="dark"] {
    --bg: #0e0e0e;
    --text: #f2f2f2;
    --muted-text: #a8a8a8;
    --soft-surface: #1a1a1a;
    --border: #f2f2f2;
    --border-soft: rgba(255, 255, 255, 0.12);
    --hover-bg: #1a1a1a;
    --nawigacja-bg: #0e0e0e;
    --film-item-border: rgba(255, 255, 255, 0.12);
    --linki-border: rgba(255, 255, 255, 0.3);
    --film-ornament: rgba(200, 170, 130, 0.35);
  }

  [data-theme="papyrus"] {
    --bg: #f4e8d0;
    --text: #3a2e1f;
    --muted-text: #6b5a45;
    --soft-surface: #ebdfc4;
    --border: #6b5a45;
    --border-soft: rgba(58, 46, 31, 0.18);
    --hover-bg: #ebdfc4;
    --nawigacja-bg: #f4e8d0;
    --film-item-border: rgba(58, 46, 31, 0.18);
    --linki-border: rgba(58, 46, 31, 0.3);
    --film-ornament: rgba(85, 61, 37, 0.4);
  }

  /* === RESET I PODSTAWY === */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    font-weight: 400;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  /* === TYPOGRAFIA === */
  h1, h2, h3, h4 {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: 1.5rem;
  }

  h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    display: inline-block;
  }

  p {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 400;
  }

  /* === NAWIGACJA === */
  .nawigacja {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 4rem;
    border-bottom: 1px solid var(--border);
    background: var(--nawigacja-bg);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .menu {
    display: flex;
    gap: 3rem;
    justify-content: flex-end;
  }

  .menu a {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 400;
    position: relative;
    transition: color 0.3s ease;
  }

  .menu a:hover {
    color: var(--muted-text);
  }

  /* === PRZEŁĄCZNIK MOTYWU === */
  .motyw-przelacz {
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
    cursor: pointer;
    border-radius: 50%;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.3s ease;
  }

  .motyw-przelacz:hover {
    background: var(--hover-bg);
  }

  .motyw-przelacz svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* === STOPKA === */
  .stopka {
    text-align: center;
    padding: 4rem 2rem;
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    transition: border-color 0.3s ease;
  }

  /* === RESPONSYWNOŚĆ === */
  @media (max-width: 768px) {
    .nawigacja {
      grid-template-columns: 1fr auto;
      grid-template-areas: "logo toggle" "menu menu";
      gap: 1.5rem;
      padding: 2rem;
    }

    .logo {
      grid-area: logo;
    }

    .motyw-przelacz {
      grid-area: toggle;
    }

    .menu {
      grid-area: menu;
      justify-content: center;
      gap: 2rem;
    }
  }
</style>
